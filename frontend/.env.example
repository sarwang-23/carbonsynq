# This ZIP is configured for an explicit browser demo by default.
NEXT_PUBLIC_DEMO_MODE=true

# Server-only connection to your working invoice backend (no /api suffix).
# Copy this file to .env.local if you need to change these defaults.
INVOICE_BACKEND_URL=http://127.0.0.1:5000
INVOICE_BACKEND_TIMEOUT_MS=180000
# Only set this if your deployed invoice service requires bearer authentication.
# INVOICE_BACKEND_AUTH_TOKEN=

# Optional for a custom frontend domain. Render's default URL is detected automatically.
# WORKSPACE_PUBLIC_URL=https://your-university.example.com

# Use these ONLY after a compatible V2 backend is available.
# NEXT_PUBLIC_DEMO_MODE=false
# NEXT_PUBLIC_API_URL=https://YOUR-V2-SERVICE/api/v2
# NEXT_PUBLIC_TENANT_ID=your-university-tenant-id
